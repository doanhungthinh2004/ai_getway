{
  "info": {
    "name": "AI Gateway API",
    "description": "Demo collection for AI Gateway",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:5000" },
    { "key": "TOKEN", "value": "" }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo User\",\n  \"email\": \"demo@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": { "raw": "{{BASE_URL}}/api/auth/register", "host": ["{{BASE_URL}}"], "path": ["api", "auth", "register"] }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": { "raw": "{{BASE_URL}}/api/auth/login", "host": ["{{BASE_URL}}"], "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "Get Me",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
        "url": { "raw": "{{BASE_URL}}/api/auth/me", "host": ["{{BASE_URL}}"], "path": ["api", "auth", "me"] }
      }
    },
    {
      "name": "Chat",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{TOKEN}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"gpt-4o-mini\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Explain what an API Gateway is\"\n    }\n  ],\n  \"temperature\": 0.7\n}"
        },
        "url": { "raw": "{{BASE_URL}}/api/ai/chat", "host": ["{{BASE_URL}}"], "path": ["api", "ai", "chat"] }
      }
    },
    {
      "name": "Analyze",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{TOKEN}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"gpt-4o-mini\",\n  \"input\": \"Analyze this customer feedback: 'The app is fast and easy to use, but checkout is confusing.'\",\n  \"schema\": {\n    \"sentiment\": \"string\",\n    \"score\": \"number\",\n    \"summary\": \"string\"\n  }\n}"
        },
        "url": { "raw": "{{BASE_URL}}/api/ai/analyze", "host": ["{{BASE_URL}}"], "path": ["api", "ai", "analyze"] }
      }
    },
    {
      "name": "List Conversations",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
        "url": { "raw": "{{BASE_URL}}/api/conversations", "host": ["{{BASE_URL}}"], "path": ["api", "conversations"] }
      }
    },
    {
      "name": "Get Conversation",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
        "url": { "raw": "{{BASE_URL}}/api/conversations/:id", "host": ["{{BASE_URL}}"], "path": ["api", "conversations", ":id"] }
      }
    },
    {
      "name": "Delete Conversation",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
        "url": { "raw": "{{BASE_URL}}/api/conversations/:id", "host": ["{{BASE_URL}}"], "path": ["api", "conversations", ":id"] }
      }
    },
    {
      "name": "Get Usage",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
        "url": { "raw": "{{BASE_URL}}/api/usage", "host": ["{{BASE_URL}}"], "path": ["api", "usage"] }
      }
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": { "raw": "{{BASE_URL}}/api/health", "host": ["{{BASE_URL}}"], "path": ["api", "health"] }
      }
    }
  ]
}
